{
  "expo": {
    "name": "MenssageFlow",
    "slug": "MenssageFlow",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "owner": "guts26",
    "extra": {
      "eas": {
        "projectId": "24b99eb6-7fd0-47ac-8aab-056efb39bc5b"
      }
    },
    "android": {
      "package": "com.guts26.menssageflow",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.guts26.menssageflow"
    }
  }
}
